# ─────────────────────────────────────────────────────────────
#  ShowCommander – Einstellungen
#  Kopieren nach .env und anpassen:   cp .env.example .env
#  Danach neu starten:                docker compose up -d
#  Leere Werte = Standard bzw. Einstellung in der App.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# Port, unter dem ShowCommander erreichbar ist
PORT=8080
# Zeitzone (wichtig für Uhrzeiten im Ablauf)
TZ=Europe/Berlin

# ── Anmeldung & Benutzer ────────────────────────────────────
# Erster Admin – wird beim Start angelegt, solange es noch KEINE Benutzer gibt.
# Bleibt beides leer, legst du den ersten Admin auf der Login-Seite an.
# Danach weitere Benutzer in der App unter „Benutzer verwalten“ anlegen.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Wie lange „Angemeldet bleiben“ gilt (Tage)
SESSION_DAYS=30
# Geheimer Schlüssel für Sitzungs-Cookies. Leer = wird automatisch erzeugt und in data/ gespeichert.
# Ändern meldet alle Benutzer ab.
SESSION_SECRET=
# Cookies nur über HTTPS senden: auto (erkennt Reverse-Proxy), true oder false
COOKIE_SECURE=auto
# Läuft ShowCommander hinter einem Reverse-Proxy (z. B. Nginx Proxy Manager)? Dann true,
# damit die Sperre nach Fehlversuchen die echte IP der Besucher verwendet.
TRUST_PROXY=false
# Anmeldung komplett abschalten (true/false). NUR in einem abgeschotteten Netz –
# dann hat jeder im Netz Admin-Rechte!
AUTH_ENABLED=true

# ── Companion / Stream Deck ──────────────────────────────────
# Schlüssel für Companion-Modul, Stream-Deck-Plugin und HTTP-Tasten (?key=... oder Header X-API-Key)
API_KEY=
# Rechte des API-Keys: viewer, operator, editor oder admin
API_KEY_ROLE=editor

# ── ChurchTools ──────────────────────────────────────────────
# Gesetzt = fest vorgegeben und in der App nicht änderbar
CT_URL=
CT_TOKEN=

# ── ProPresenter (ab 7.9) ────────────────────────────────────
# Gesetzter Host schaltet die Anbindung automatisch ein
PP_HOST=
PP_PORT=1025
# PP_ENABLED=true
# PP_TIMER_NAME=ShowCommander
# PP_STAGE_MESSAGE=true
# PP_TEMPLATE=▶ {current}   ·   Danach: {next}

# ── Aufbewahrung ─────────────────────────────────────────────
# Abläufe nach X Tagen automatisch löschen (0 = nie). Leer = Einstellung in der App (Standard 14)
RETENTION_DAYS=
